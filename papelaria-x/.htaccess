# Papelaria X - Regras de Segurança e Compatibilidade InfinityFree
Options -Indexes

# Proteger arquivos sensíveis e de configuração
<FilesMatch "\.(sql|md|log|ini|env|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloquear acesso direto via navegador às pastas internas
    RewriteRule ^(config|includes|database)/ - [F,L]

    # Bloquear arquivos ocultos (.git, .env, etc.)
    RewriteRule ^\. - [F,L]
</IfModule>
